# SQLite database (orchestrator state)
DATABASE_URL="file:./data/orchestrator.db"

# Where workers will be spawned by default (can override per-worker)
DEFAULT_WORKSPACE_ROOT="C:/Users/PC/workspaces"

# Claude CLI binary (usually just "claude" if on PATH)
CLAUDE_BIN="claude"

# Default model for new workers (opus|sonnet|haiku or full id)
DEFAULT_MODEL="claude-opus-4-7"
DEFAULT_WATCHER_MODEL="claude-haiku-4-5-20251001"
