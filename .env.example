# SQLite database (orchestrator state)
DATABASE_URL="file:./data/orchestrator.db"

# Where workers will be spawned by default (can override per-worker)
DEFAULT_WORKSPACE_ROOT="/Users/yeneryigit/workspaces"

# Claude CLI binary (usually just "claude" if on PATH)
CLAUDE_BIN="claude"

# Lead (orkestratör) worker'ının modeli — varsayılan Opus (en üst katman).
# Helper'ların modeli rol bazında belirlenir (src/core/role-prompts.ts):
# salt-okuma/mekanik haiku, standart üretim sonnet, debug+security opus.
# Lead spawn_helper'da görev zorluğuna göre bunu override eder — karar Lead'in.
LEAD_MODEL="claude-opus-4-8"

# Orchestrator daemon — worker'lar + DB ayrı bir process'te çalışır.
# Panel (Next.js) :3005, daemon :3006. Lead'in MCP server'ı doğrudan daemon'a bağlanır.
DAEMON_PORT="3006"
ORCHESTRATOR_API_URL="http://127.0.0.1:3006"

# Next.js panel portu (launcher bunu kullanır)
PORT="3005"

# Proje hafızası (.agentwiki) — yerel embedding ile semantik arama (zero API cost).
# İlk memory_search'te model (~25MB) bir kez iner, sonra offline. Kapatmak için 0:
# MEMORY_EMBEDDINGS="1"          # 0/false → embedding kapanır, arama keyword-only
# MEMORY_STALE_DAYS="60"         # lint: bu kadar gün güncellenmemiş + az erişilen = "bayat"
# MEMORY_WORKING_TTL_DAYS="7"    # working/ sayfaları bu kadar gün sonra budanır

# Telegram bot (opsiyonel) — token boş bırakılırsa bot devre dışı kalır.
# 1) BotFather'da yeni bot oluştur → token al
# 2) Botla konuş, kendi chat_id'ni öğren (örn. @userinfobot)
# 3) Sadece bu chat_id'den gelen komutları kabul et — başka kimse bot'u kullanamaz
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
