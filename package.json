{
  "name": "orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "//": "MIMARI: orchestrator daemon (worker'lar + DB, ayri process) + Next.js (UI/API). 'dev' ve 'start/prod' ikisini birlikte ayaga kaldirir (scripts/launch.mjs). 'dev' UI icin HMR'li; 'prod' build edip production calistirir. 'daemon' yalniz daemon'i baslatir (debug). DAEMON_PORT vars 3006, panel 3005.",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "prod": "node scripts/kill-orphans.mjs && pnpm install --ignore-scripts && pnpm db:generate && next build && node scripts/start.mjs",
    "daemon": "node --import tsx --env-file-if-exists=.env src/core/daemon-server.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.1.0",
    "clsx": "^2.1.1",
    "next": "^16.0.0",
    "node-cron": "^4.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.1",
    "prisma": "^6.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "onnxruntime-node",
      "prisma",
      "protobufjs",
      "sharp"
    ]
  }
}
