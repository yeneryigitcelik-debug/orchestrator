// Prisma schema — orchestrator state
// Detaylı tablolar Task #5 içinde işlenecek; bu sadece iskelet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Worker {
  id          String   @id @default(cuid())
  name        String
  role        String   // backend | frontend | watcher | db | custom
  model       String   // claude-opus-4-7 | claude-haiku-4-5-* | ...
  cwd         String
  sessionId   String?  @unique
  status      String   @default("idle") // idle | running | thinking | crashed | stopped
  goal        String?  // mevcut otonom görev (null = boşta)
  autonomous  Boolean  @default(true)
  iteration   Int      @default(0)
  goalStartedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]
}

model Message {
  id         String   @id @default(cuid())
  workerId   String
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  direction  String   // in | out
  type       String   // assistant | user | tool_use | tool_result | system | result | ...
  payload    String   // raw JSON
  createdAt  DateTime @default(now())

  @@index([workerId, createdAt])
}

// --- Review / scan modu (agent-orchestra merge) ---

model Scan {
  id         String    @id @default(cuid())
  repo       String    // taranan dizin (cwd)
  roles      String    // JSON: istenen review rolleri
  status     String    @default("running") // running | done | failed
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  findings   Finding[]
}

model Finding {
  id        String   @id @default(cuid())
  scanId    String
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  agent     String   // security | performance | database | api | infrastructure | quality | ui | ux | cost
  severity  String   // critical | high | medium | low | info
  rule      String
  file      String
  line      Int?
  why       String
  fix       String?
  evidence  String?
  createdAt DateTime @default(now())

  @@index([scanId, severity])
  @@index([scanId, agent])
}

// --- Audit log ---

model AuditEvent {
  id        String   @id @default(cuid())
  actor     String?  // user | lead | webhook:github | ...
  action    String   // scan.start | scan.diff | worker.spawn | worker.kill | webhook.recv | ...
  target    String?  // scanId | workerId | repo
  detail    String?  // JSON payload
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// --- Autonomous mode: backlog + thinking + scheduler ---

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          String    @default("pending") // pending | in_progress | done | blocked | cancelled
  priority        Int       @default(5) // 1 (en yüksek) .. 10 (en düşük)
  source          String    @default("user") // user | lead-ideation | scheduler | telegram
  cwd             String?   // task'ın hangi projede çalışacağı; null = orchestrator kararı
  goal            String?   // task'a karşılık spawn edilecek helper goal'ü; null = Lead serbest
  assignedWorkerId String?
  result          String?   // tamamlandığında özet
  blockReason     String?   // blocked olduğunda sebep
  runId           String?   // hangi AutonomousRun içinde işlendi
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?

  @@index([status, priority, createdAt])
  @@index([source])
  @@index([runId])
}

model Thought {
  id        String   @id @default(cuid())
  content   String
  type      String   // observation | idea | question | decision | plan | checkpoint | drift-alarm | rationale
  workerId  String?  // hangi worker düşündü (genelde Lead)
  taskId    String?  // ilgili task
  runId     String?  // ilgili autonomous run
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([runId, createdAt])
}

model AutonomousRun {
  id               String    @id @default(cuid())
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  iterations       Int       @default(0)
  tasksCompleted   Int       @default(0)
  checkpointsHit   Int       @default(0)
  terminatedReason String?   // user-stop | drift | iter-cap | error | manual-checkpoint | rate-limit
  summary          String?
  triggeredBy      String    @default("user") // user | scheduler | telegram

  @@index([startedAt])
}

model ScheduledJob {
  id        String    @id @default(cuid())
  name      String    @unique
  cron      String    // standart cron: "0 2 * * *" gibi
  prompt    String    // Lead'e gönderilecek mesaj / task açıklaması
  kind      String    @default("lead-message") // lead-message | create-task | scan-repo
  payload   String?   // JSON: kind'a göre ek param (örn. scan-repo için repo path)
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([enabled, nextRunAt])
}

model Config {
  key       String   @id
  value     String   // JSON-encoded
  updatedAt DateTime @updatedAt
}

// Lead'in kullanıcıya yönelttiği sorular — ask_user MCP tool'u kullanır.
// Lead soru sorar, cevap bekler (poll/SSE). Kullanıcı UI/Telegram'dan cevap verir.
model UserQuestion {
  id           String    @id @default(cuid())
  workerId     String?   // soruyu soran worker (genelde Lead)
  taskId       String?
  runId        String?
  question     String
  choices      String?   // JSON: ["evet", "hayır", "..."] — opsiyonel multi-choice
  status       String    @default("pending") // pending | answered | cancelled | timeout
  answer       String?
  askedAt      DateTime  @default(now())
  answeredAt   DateTime?
  timeoutAt    DateTime?

  @@index([status, askedAt])
}
